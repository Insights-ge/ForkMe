{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Sliding door builder payload",
    "type": "object",
    "additionalProperties": false,
    "required": ["catalog", "metadata"],
    "properties": {
        "catalog": {
            "type": "object",
            "additionalProperties": false,
            "required": ["models", "infills"],
            "properties": {
                "models": { "type": "array", "items": { "$ref": "#/$defs/model" } },
                "infills": { "type": "array", "items": { "$ref": "#/$defs/infill" } }
            }
        },
        "metadata": {
            "description": "Presentation presets, kept separate from catalog facts.",
            "type": "object",
            "additionalProperties": false,
            "required": ["layoutPresets", "frameColors", "infillVisuals", "neutralVisual"],
            "properties": {
                "layoutPresets": { "type": "array", "items": { "$ref": "#/$defs/layoutPreset" } },
                "frameColors": { "type": "array", "items": { "$ref": "#/$defs/frameColor" } },
                "infillVisuals": { "type": "array", "items": { "$ref": "#/$defs/infillVisual" } },
                "neutralVisual": { "$ref": "#/$defs/visual" }
            }
        }
    },
    "$defs": {
        "visual": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fill"],
            "properties": {
                "fill": { "type": "string", "pattern": "^#[0-9A-F]{6}$" }
            }
        },
        "frameColor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["color", "label", "visual"],
            "properties": {
                "color": { "enum": ["black", "inox", "graphite", "silver"] },
                "label": { "type": "string" },
                "visual": { "$ref": "#/$defs/visual" }
            }
        },
        "infillVisual": {
            "type": "object",
            "additionalProperties": false,
            "required": ["infillId", "visual"],
            "properties": {
                "infillId": { "$ref": "#/$defs/id" },
                "visual": { "$ref": "#/$defs/visual" }
            }
        },
        "layoutPreset": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "panelWeights", "requiresPartition"],
            "properties": {
                "id": { "enum": ["full_panel", "two_horizontal_panels", "three_horizontal_panels"] },
                "label": { "type": "string" },
                "panelWeights": {
                    "description": "Relative heights from top to bottom. Equal weights produce equal horizontal panels.",
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 }
                },
                "requiresPartition": { "type": "boolean" }
            },
            "oneOf": [
                { "properties": { "id": { "const": "full_panel" }, "panelWeights": { "const": [1] }, "requiresPartition": { "const": false } } },
                { "properties": { "id": { "const": "two_horizontal_panels" }, "panelWeights": { "const": [1, 1] }, "requiresPartition": { "const": true } } },
                { "properties": { "id": { "const": "three_horizontal_panels" }, "panelWeights": { "const": [1, 1, 1] }, "requiresPartition": { "const": true } } }
            ]
        },
        "id": { "type": "integer", "minimum": 1 },
        "model": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "minHeight", "maxHeight", "minWidth", "maxWidth", "notRecommendedHeightMin", "notRecommendedHeightMax", "variants"],
            "properties": {
                "id": { "$ref": "#/$defs/id" },
                "name": { "type": "string" },
                "minHeight": { "type": "integer" },
                "maxHeight": { "type": "integer" },
                "minWidth": { "type": "integer" },
                "maxWidth": { "type": "integer" },
                "notRecommendedHeightMin": { "type": ["integer", "null"] },
                "notRecommendedHeightMax": { "type": ["integer", "null"] },
                "variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } }
            }
        },
        "variant": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "color", "frameDesignCode", "heightRangeMin", "heightRangeMax", "hasPartition", "hasSoftCloseMechanism", "components"],
            "properties": {
                "id": { "$ref": "#/$defs/id" },
                "name": { "type": "string" },
                "color": { "enum": ["black", "inox", "graphite", "silver"] },
                "frameDesignCode": { "type": "string" },
                "heightRangeMin": { "type": "integer" },
                "heightRangeMax": { "type": "integer" },
                "hasPartition": { "type": "boolean" },
                "hasSoftCloseMechanism": { "type": "boolean" },
                "components": { "type": "array", "items": { "$ref": "#/$defs/component" } }
            }
        },
        "component": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "incompatibleInfillIds"],
            "properties": {
                "id": { "$ref": "#/$defs/id" },
                "type": { "enum": ["side_profile", "top_rail", "bottom_rail", "partition", "soft_close_mechanism"] },
                "incompatibleInfillIds": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/id" }
                }
            }
        },
        "infill": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "code", "description"],
            "properties": {
                "id": { "$ref": "#/$defs/id" },
                "code": { "type": "string" },
                "description": { "type": "string" }
            }
        }
    }
}
